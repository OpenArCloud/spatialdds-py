# Where everything vendored here came from.
#
# Two kinds of thing, from two places, both copies and both pinned.
#
# The web-binding artifacts are generated in the SpatialDDS specification
# repository by web-binding/gen.py, which is a pure function of the IDL. They
# are vendored so this repository runs and its gates check without a second
# checkout. Upstream is authoritative; nothing here is hand-edited.
#
# As of 0.2.0 they live inside the distribution, under
# lib/spatialdds/spatialdds/artifacts/, because `pip install
# "spatialdds[server]"` has to stand up a conformant endpoint with no clone:
# the schemas are served, the tables drive the mapping in both directions, and
# the IDL is the type source a registry boots from when it starts empty. One
# copy, read by both halves of the package and by every gate.

repository = https://github.com/OpenArCloud/SpatialDDS-spec
artifacts_tag = v1.8
artifacts_commit = 4b5652c6b52a2c10f4f4c5b686be7cf979d8b8fc
# The tag, and the commit it names, that the generated artifacts above were
# produced at. 0.7.0 moved the whole package here from 9c3e1f2 at once --
# artifacts, IDL, the native layer's bindings and its registry -- because one
# package with two pins would be two type systems in one wheel. Everything
# vendored is byte-identical at v1.8, v1.8.1 and v1.8.2: those two moved only
# the conformance runner and the changelog. The normative *text* this gateway
# implements is pinned separately in docs/EVIDENCE.md, because prose and
# artifacts have moved on different commits before (169fabd amended
# Appendix N without regenerating anything; 9c3e1f2 regenerated without
# changing the appendix).
source_tree = web-binding/

artifacts_dir = lib/spatialdds/spatialdds/artifacts/

mapping.file = webjson/MAPPING.md
mapping.sha256 = bf358ce6e4f16b55905eb04b95ec365760b7b5c33e5dd2ffd8280f21ce6d78d3
serializer_tables.file = lib/spatialdds/spatialdds/artifacts/serializer_tables.json
serializer_tables.sha256 = 46cd9bdb20376c79629f14276e50c438880c6a4712e9e810cf77ed66c8063392
schemas.dir = lib/spatialdds/spatialdds/artifacts/schemas/
schemas.count = 112
schemas.set_sha256 = 97906152283cec93cd6c19e28e73c870b8b73dc4b583a24109acb30bff851ab8
golden.count = 9

# The IDL itself, vendored at the same commit as the generated artifacts above
# and for one reason: a registry that starts empty has no recording to read its
# types out of, and the serializer tables cannot stand in because they carry no
# @key annotations -- so the instances of a keyed resource could not be named.
# These three files are the closure of the publishable kinds (Announce,
# ContentAnnounce, GeoAnchor); `spatialdds.server.pin` flattens them the same
# way a recording's embedded schema records are flattened, and
# gates/fresh_start.py requires the model parsed from them to agree with the
# tables beside them.

idl.dir = lib/spatialdds/spatialdds/artifacts/idl/
idl.source_tree = idl/v1.8/
idl.count = 3
idl.files = core.idl, discovery.idl, types.idl
# Set digests (schemas, idl) are sha256 over, for each file in name order, the
# file's name then the sha256 of its bytes. gates/schema_fidelity.py recomputes
# every digest and count in this file; until 0.7.0 only two of them were, and
# the idl digest recorded here reproduced by no method (finding 59).
idl.set_sha256 = 7cb8eb76507955d63a849ddd395f1b75857ec6b67abbf51cbd69bea7ca0e8a78

# The recording. This is the data interface: a typed SpatialDDS 1.8 MCAP,
# carrying its own IDL in its schema records, which is the only description
# of the wire this repository needs. It was produced by a SceneScape adapter
# and published in that adapter's repository; nothing here depends on that
# adapter's code, and this gateway serves any recording of the same shape.

recording.repository = https://github.com/OpenArCloud/spatialdds-scenescape
recording.file = samples/queuing-retail-sample.mcap
recording.sha256 = 44eb689d3e4e029582ab84be7f7e06c7aaf2ebe046202f974fa63663fe345154
recording.bytes = 1407451
recording.messages = 15676
recording.topics = 11
recording.summary.file = samples/queuing-retail-sample.summary.json
recording.summary.sha256 = e56d26cd6eca1442bdd83e897684d2e62842f6f8098c5e340ff7d7a773d7bbe3
